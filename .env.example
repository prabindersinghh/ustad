# Meta Model API key - claim from the hackathon credits form
MODEL_API_KEY=your_key_here

# Base URL for Meta Model API (OpenAI-compatible)
META_BASE_URL=https://api.meta.ai/v1

# Reasoning / vision model. 1.3 is strongest for image+text.
SPARK_MODEL=muse-spark-1.3

# Audio-capable Spark (1.3 audio understanding is not fully supported)
SPARK_AUDIO_MODEL=muse-spark-1.2

# Segmentation / grounding
SAM_MODEL=sam-3.1

# Speech to text
ASR_MODEL=muse-voice-transcribe-1.0

# sqlite path
DB_PATH=data/ustad.db

# Capture self-check: after a procedure is generated, SAM tries to ground every
# target_phrase and bad ones are regenerated once. Set to 0 to disable.
VALIDATE_PROCEDURE=1

# --------------------------------------------------------------------------
# Open-weights reasoning backend (optional)
#
# "hosted" uses the Meta Model API. "open" routes the verification reasoning
# to a Meta open-weight model you deployed yourself -- which is what makes
# the build eligible for Best Build on Meta Open Weight Models, and what lets
# a factory keep its line footage on its own infrastructure.
#
# Muse Glimmer for the second opinion (keep REASONING_BACKEND=hosted for live):
#   OPEN_BASE_URL=https://integrate.api.nvidia.com/v1
#   OPEN_MODEL=meta/muse-glimmer-30b
#   OPEN_API_KEY=<a key from build.nvidia.com>
# Or deploy Muse Glimmer on Modal (needs a card on the workspace):
#   modal endpoint create --model meta-models/Muse-Glimmer-30B
#   modal workspace proxy-tokens create
# Then OPEN_API_KEY is the token as  wk-<id>.ws-<secret>
# and OPEN_BASE_URL is the endpoint URL with /v1 appended.
# --------------------------------------------------------------------------
REASONING_BACKEND=hosted
OPEN_BASE_URL=
OPEN_API_KEY=
OPEN_MODEL=meta-models/Muse-Glimmer-30B
OPEN_FALLBACK=1
